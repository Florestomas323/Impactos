rules_version = '2';
// ═══════════════════════════════════════════════════════════════════════════
// ImpactOS — Firestore Rules v2   (PREPARADAS, NO PUBLICADAS en producción)
//
// • Cero correos escritos aquí: todo se valida contra users/{uid},
//   invitations/{email} y workspaces/{appId}.
// • Invitaciones, roles, estados, cupos y cambios de app los escribe SOLO el
//   servidor (/api/users con firebase-admin, que no pasa por estas reglas).
//   Desde un teléfono nadie puede crearse un rol ni saltarse un cupo.
// • El Súper Admin se crea UNA vez a mano; ninguna regla permite crear otro.
// • crm_telemarketing queda congelado como respaldo.
// ═══════════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identidad ─────────────────────────────────────────────────────────
    function signedIn()  { return request.auth != null; }
    function uid()       { return request.auth.uid; }
    function myEmail()   { return request.auth.token.email.lower(); }
    function verified()  { return request.auth.token.email_verified == true; }
    function userPath(u) { return /databases/$(database)/documents/users/$(u); }
    function invPath(e)  { return /databases/$(database)/documents/invitations/$(e); }

    function me()         { return get(userPath(uid())).data; }
    // Activo = existe users/{uid} Y status == 'active'. inactive/suspended pierden todo al instante.
    function active()     { return signedIn() && exists(userPath(uid())) && me().status == 'active'; }
    function isSuper()    { return active() && me().role == 'super_admin'; }
    function inApp(a)     { return active() && me().appId == a; }
    function isStaffOf(a) { return inApp(a) && me().role in ['distribuidor', 'supervisor']; }
    function isDistOf(a)  { return inApp(a) && me().role == 'distribuidor'; }
    function staffOrSuper(a) { return isSuper() || isStaffOf(a); }

    function validRole(r) {
      return r in ['distribuidor', 'supervisor', 'telemarketing_ventas',
                   'telemarketing_cobranza', 'telemarketing_reclutamiento'];
    }

    // ── USUARIOS ──────────────────────────────────────────────────────────
    match /users/{userId} {
      allow get: if signedIn() && (userId == uid() || isSuper()
        || (active() && me().role in ['distribuidor', 'supervisor'] && resource.data.appId == me().appId));
      allow list: if isSuper()
        || (active() && me().role in ['distribuidor', 'supervisor'] && resource.data.appId == me().appId);

      // Única forma de nacer desde la app: aceptar TU invitación con TU Google.
      allow create: if signedIn() && verified() && userId == uid()
        && exists(invPath(myEmail()))
        && get(invPath(myEmail())).data.status == 'invited'
        && request.resource.data.role == get(invPath(myEmail())).data.role
        && request.resource.data.appId == get(invPath(myEmail())).data.appId
        && validRole(request.resource.data.role)
        && request.resource.data.status == 'active'
        && request.resource.data.emailNormalized == myEmail()
        && getAfter(invPath(myEmail())).data.status == 'accepted'
        && getAfter(invPath(myEmail())).data.acceptedUid == uid();

      // Uno mismo: solo su "última actividad". Todo lo demás: servidor.
      allow update: if active() && userId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt']);
      allow delete: if false;
    }

    // ── INVITACIONES (id = correo en minúsculas) ──────────────────────────
    match /invitations/{email} {
      allow get: if signedIn() && (email == myEmail() || isSuper()
        || (resource != null && isStaffOf(resource.data.appId)));
      allow list: if isSuper() || isStaffOf(resource.data.appId);
      allow create, delete: if false;             // solo el servidor
      // El invitado la acepta en el MISMO lote en que nace su perfil.
      allow update: if signedIn() && verified() && email == myEmail()
        && resource.data.status == 'invited'
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedUid == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedUid', 'acceptedAt'])
        && existsAfter(userPath(uid()));
    }

    // ── APPS / WORKSPACES ─────────────────────────────────────────────────
    match /workspaces/{appId} {
      allow read:   if isSuper() || inApp(appId);
      allow create, delete: if false;             // servidor / consola
      // counts y limits: solo el servidor. El Súper Admin edita el resto.
      allow update: if isSuper()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['counts', 'limits']);

      // ── REGISTROS: un documento por cliente / prospecto / cuenta ─────────
      // La sección es un CAMPO. El telemarketing consulta con
      // assignedTo == su uid Y section == una de las suyas: así cada consulta
      // es verificable completa por estas reglas.
      match /records/{recId} {
        function validSection(x) {
          return x in ['agregados', 'referidos', 'prospectos', 'distribucion', 'cobranza', 'reclutamiento'];
        }
        // Mismo mapa que src/data/schema.ts (SECTIONS_FOR_ROLE).
        function sectionAllowed(r, x) {
          // Distribución ES ventas; Cobranza es otra especialidad (solo sus cuentas).
          return (r == 'telemarketing_ventas'        && x in ['agregados', 'referidos', 'prospectos', 'distribucion'])
              || (r == 'telemarketing_cobranza'      && x in ['cobranza'])
              || (r == 'telemarketing_reclutamiento' && x in ['reclutamiento']);
        }
        function tmOn(x) { return inApp(appId) && sectionAllowed(me().role, x); }
        // Un telemarketing jamás toca responsable, historial de asignación ni origen.
        function assignmentUntouched() {
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'appId', 'section', 'assignedTo', 'assignedToName', 'assignedBy', 'assignedAt',
            'lastAssignedAt', 'assignmentType', 'assignmentStatus', 'assignmentHistory',
            'workStatus', 'asignado_a', 'legacyId', 'legacySource', 'createdByUid']);
        }

        allow read: if staffOrSuper(appId)
          || (tmOn(resource.data.section) && resource.data.assignedTo == uid());

        allow create: if request.resource.data.appId == appId && validSection(request.resource.data.section)
          && (staffOrSuper(appId)
              || (tmOn(request.resource.data.section)
                  && request.resource.data.assignedTo == uid()
                  && request.resource.data.createdByUid == uid()));

        allow update: if request.resource.data.appId == appId
          && validSection(request.resource.data.section)
          && (staffOrSuper(appId)
              || (tmOn(resource.data.section) && resource.data.assignedTo == uid() && assignmentUntouched()));

        // Borrado físico: Distribuidor o Súper Admin. La papelera es eliminado=true.
        allow delete: if isSuper() || isDistOf(appId);
      }

      // ── AGENDA ────────────────────────────────────────────────────────────
      match /appts/{apptId} {
        function mine(d) { return d.get('assignedTo', null) == uid() || d.get('createdByUid', null) == uid(); }
        function tipoDe(d) { return d.get('tipo', d.get('_type', '')); }

        // Tipos de evento que cada telemarketing puede CREAR. MISMA tabla que
        // TIPOS_AGENDA_POR_ROL (src/services/commandCenter.ts). El staff no tiene esta limitación.
        function apptTypeAllowed(role, tipo) {
          return (role == 'telemarketing_ventas'        && tipo in ['cita', 'llamada'])
              || (role == 'telemarketing_cobranza'      && tipo == 'llamada')
              || (role == 'telemarketing_reclutamiento' && tipo in ['entrevista', 'llamada']);
        }

        // ── CREATE de telemarketing: cita "limpia" ──
        // Nace a su nombre (createdByUid = uid), SIN asignar (assignedTo = null: hoy no existe
        // asignación de vendedor; así nadie puede hacer visible un cliente a otra TLK), de un
        // tipo permitido para su rol y sin nada que solo produce el staff o una visita real.
        // createdByName NO se valida: el UID es la autoridad (el nombre puede cambiarse desde
        // el servidor con usersCore.rename y la sesión abierta conserva el anterior); el store
        // lo genera desde el usuario autenticado. Ver docs/ACCESO_V2.md.
        function camposNoIniciales() {
          return ['resultado_detalle', 'monto', 'cartucho_meses', 'resultByUid', 'resultByName', 'resultAt',
                  'cancelledAt', 'cancelledByUid', 'cancelledByName', 'cancelReason',
                  'reprogramHistory', 'reprogrammedFromApptId', 'createdFrom',
                  'servicioResultado', 'servicioHistorial',
                  '_sincronizado', '_clienteId', '_clienteGrupo'];
        }
        // ── Registro de origen en CREATE de telemarketing ──
        // Sin source → cita manual (permitida). Con source → el registro debe existir en ESTE
        // workspace, con la misma sección, asignado a esta TLK y de SU especialidad.
        // Ruta real (src/data/schema.ts docIdFor): Cobranza vive en records/cob_<clave>
        // (la app usa la clave legacy como id); el resto en records/<id>. Referidos: el
        // documento es el ANFITRIÓN y sourceRefIndex el referido dentro de él.
        // Mismo mapa que records.sectionAllowed / schema.ts SECTIONS_FOR_ROLE.
        function seccionDeRol(r, x) {
          return (r == 'telemarketing_ventas'        && x in ['agregados', 'referidos', 'prospectos', 'distribucion'])
              || (r == 'telemarketing_cobranza'      && x in ['cobranza'])
              || (r == 'telemarketing_reclutamiento' && x in ['reclutamiento']);
        }
        function sourceDocId(d) {
          return d.sourceSection == 'cobranza' ? 'cob_' + d.sourceRecordId : d.sourceRecordId;
        }
        function sourcePath(d) {
          return /databases/$(database)/documents/workspaces/$(appId)/records/$(sourceDocId(d));
        }
        // sourceRefIndex es la POSICIÓN del referido (la app recorre la lista o, en datos
        // legacy, los valores del mapa en orden), NO la clave del mapa. Sin índice = cita del
        // anfitrión (permitida). Con índice: referidos debe existir (lista o mapa) y el índice
        // debe estar dentro de su tamaño.
        function refIndexOk(d, rec) {
          return !d.keys().hasAny(['sourceRefIndex'])
            || (d.sourceSection == 'referidos' && d.sourceRefIndex is int && d.sourceRefIndex >= 0
                && (rec.get('referidos', null) is list || rec.get('referidos', null) is map)
                && d.sourceRefIndex < rec.referidos.size());
        }
        function tmSourceOk(d) {
          return !d.keys().hasAny(['sourceRecordId', 'sourceSection', 'sourceRefIndex'])
            || (d.get('sourceRecordId', null) is string && d.sourceRecordId.size() > 0
                && d.get('sourceSection', null) is string
                && seccionDeRol(me().role, d.sourceSection)
                && exists(sourcePath(d))
                && get(sourcePath(d)).data.get('section', null) == d.sourceSection
                && get(sourcePath(d)).data.get('appId', null) == appId
                && get(sourcePath(d)).data.get('assignedTo', null) == uid()
                && refIndexOk(d, get(sourcePath(d)).data));
        }
        function tmCreaOk(d) {
          return d.get('createdByUid', null) == uid()
            && d.get('assignedTo', null) == null
            && apptTypeAllowed(me().role, tipoDe(d))
            && d.get('_type', tipoDe(d)) == tipoDe(d)
            && d.get('resultado', null) in [null, '']
            && d.get('status', '') != 'cancelada'
            && !d.keys().hasAny(camposNoIniciales())
            && tmSourceOk(d);
        }

        // ── UPDATE de telemarketing: ALLOWLIST (lo que no está aquí, no se toca) ──
        // Datos operativos del cliente y la fecha, reprogramar ANTES de la visita y cancelar.
        // Todo lo demás (id, appId, tipo, _type, assignedTo, createdBy*, source*, resultado y
        // resultBy*, producto, monto, cartucho_meses, servicio*, _sincronizado, _cliente*,
        // createdFrom, reprogrammedFromApptId, eliminado y cualquier campo futuro) queda fuera.
        function tmEditables() {
          return ['nombre', 'telefono', 'direccion', 'ciudad', 'cp', 'fecha', 'notas',
                  'reprogramHistory',
                  'status', 'cancelledAt', 'cancelledByUid', 'cancelledByName', 'cancelReason'];
        }
        function camposCancelacion() { return ['status', 'cancelledAt', 'cancelledByUid', 'cancelledByName', 'cancelReason']; }
        // Cancelar: solo a "cancelada", firmada por quien cancela (cancelledByUid = uid) y con fecha.
        function tmCancelaOk(n) {
          return n.get('status', '') == 'cancelada'
            && n.get('cancelledByUid', null) == uid()
            && n.get('cancelledAt', '') is string && n.get('cancelledAt', '').size() > 0;
        }
        // Reprogramar antes de la visita: cambiar la fecha exige agregar UNA entrada al historial
        // (se conservan las anteriores), firmada por quien reprograma y con la fecha nueva.
        function tmReprogramaOk(n, v) {
          let antes = v.get('reprogramHistory', []);
          let despues = n.get('reprogramHistory', []);
          return despues is list && despues.size() == antes.size() + 1
            && despues.hasAll(antes)
            && despues[antes.size()].get('changedByUid', null) == uid()
            && despues[antes.size()].get('reason', '') == 'before_visit'
            && despues[antes.size()].get('newDate', '') == n.get('fecha', '');
        }
        function tmActualizaOk(n, v) {
          let cambios = n.diff(v).affectedKeys();
          return mine(v)
            && v.get('status', '') != 'cancelada'                       // cancelada = solo lectura
            && v.get('resultado', null) in [null, '']                   // con resultado físico (incl. venta/no_venta) = solo lectura
            && cambios.hasOnly(tmEditables())
            && (!cambios.hasAny(camposCancelacion()) || tmCancelaOk(n))
            && (!cambios.hasAny(['fecha', 'reprogramHistory']) || tmReprogramaOk(n, v));
        }

        allow read:   if staffOrSuper(appId) || (inApp(appId) && mine(resource.data));
        allow create: if request.resource.data.appId == appId
          && (staffOrSuper(appId) || (inApp(appId) && tmCreaOk(request.resource.data)));
        allow update: if request.resource.data.appId == appId
          && (staffOrSuper(appId) || (inApp(appId) && tmActualizaOk(request.resource.data, resource.data)));
        // Borrado físico: solo administración. El flujo normal es Cancelar (queda en el historial).
        allow delete: if isSuper() || isDistOf(appId);
      }

      // ── Config compartida de la app ──────────────────────────────────────
      // MISMAS listas que src/data/schema.ts (SHARED_READ_KEYS_BY_ROLE /
      // SHARED_WRITE_KEYS_BY_ROLE); tests/rutasCumple.test.ts verifica que coincidan.
      // Staff lee y escribe todo. Cada telemarketing, SOLO lo que su operación usa y no
      // trae clientes ajenos: nunca rutas, cumpleanos, notificaciones ni cumpleNotifs
      // (sus versiones personales viven en userData/{uid}), ni incentivos…
      match /shared/{docId} {
        function tmLee() {
          return inApp(appId) && (
               (me().role == 'telemarketing_ventas'        && docId in ['catalogoCustom', 'cumpleMsgTpl', 'callLog'])
            || (me().role == 'telemarketing_cobranza'      && docId in ['cobranza'])
            || (me().role == 'telemarketing_reclutamiento' && docId in ['socios', 'docsSocios']));
        }
        // Telemarketing Ventas NO escribe ningún shared global (sin rama para Ventas).
        function tmEscribe() {
          return inApp(appId) && (
               (me().role == 'telemarketing_cobranza'      && docId in ['cobranza'])
            || (me().role == 'telemarketing_reclutamiento' && docId in ['socios', 'docsSocios']));
        }
        allow read:  if staffOrSuper(appId) || tmLee();
        allow write: if (staffOrSuper(appId) || tmEscribe()) && docId != 'callLog';   // el histórico de llamadas es solo lectura
      }

      // ── Datos propios de cada persona (llamadas, rutas, cumpleaños y notificaciones personales) ──
      // Cada quien lee y escribe SOLO el suyo; el staff lee el del equipo (Rutas del equipo).
      match /userData/{userId} {
        allow read:  if staffOrSuper(appId) || (inApp(appId) && userId == uid());
        allow write: if inApp(appId) && userId == uid();
      }

      // ── Bitácora (la escribe el servidor) y avance del migrador ─────────
      match /audit/{logId}   { allow read: if staffOrSuper(appId); allow write: if false; }
      match /_migration/{v}  { allow read: if isSuper();           allow write: if false; }
    }

    // ── SISTEMA ANTERIOR: congelado como respaldo ─────────────────────────
    match /crm_telemarketing/{docId} {
      allow read:  if isSuper();
      allow write: if false;
    }
  }
}
